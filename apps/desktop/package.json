{
  "name": "open-motion-studio",
  "productName": "Open Motion Studio",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source desktop IDE for making motion video with an agent.",
  "license": "Apache-2.0",
  "author": "motionhub",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
